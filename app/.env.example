# Console API key (shown once on the API-key reveal screen). Must be read_write + Create-capable.
CONSOLE_API_KEY=hbr_replace_me

# Service private key bound to the API key (Sui Bech32 format, shown once with the API key).
# Used to sign the reserve transaction and to authenticate Seal decrypt sessions.
# Renamed from CONSOLE_SERVICE_PRIVKEY in October 2026; the old name still works.
CONSOLE_SERVICE_PRIVATE_KEY=suiprivkey1replaceme

